{
  "name": "koa2-app-template",
  "version": "1.0.1",
  "description": "Koa2快速启动基础框架",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/app.js",
    "dev:win": "chcp 65001>nul & cross-env NODE_ENV=development nodemon src/app.js",
    "build": "node scripts/build.js",
    "build:test": "npm run build --mode test",
    "build:prod": "npm run build --mode production",
    "deploy:test": "npm run build:test && pm2 reload ecosystem.config.cjs --only koa-app-test",
    "deploy:prod": "npm run build:prod && pm2 reload ecosystem.config.cjs --only koa-app-prod",
    "manual:release": "node scripts/release.js",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "release:changelog": "release-it --only-changelog",
    "release:github": "release-it --ci --github.release",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:alpha": "release-it --preRelease=alpha",
    "release:beta": "release-it --preRelease=beta",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:fix": "prettier --write .",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "docs:openapi": "node scripts/generateApiDoc.js",
    "docs:md": "node scripts/generateApiMd.js",
    "docs": "npm run docs:openapi && npm run docs:md",
    "docs:serve": "npm run docs && npx docsify-cli serve docs --port 4000"
  },
  "dependencies": {
    "@koa/router": "^13.1.1",
    "axios": "1.7.9",
    "bcrypt": "6.0.0",
    "dotenv": "17.2.3",
    "joi": "18.0.2",
    "jsonwebtoken": "8.5.1",
    "knex": "3.1.0",
    "koa": "2.16.3",
    "koa-body": "4.2.0",
    "koa-compress": "5.1.1",
    "koa-session": "6.4.0",
    "koa-static": "5.0.0",
    "koa2-cors": "2.0.6",
    "moment": "2.30.1",
    "mysql2": "3.16.1",
    "pino": "10.3.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "uuid": "13.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@eslint/js": "8.57.0",
    "@release-it/conventional-changelog": "10.0.4",
    "conventional-changelog-angular": "8.1.0",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "cross-env": "7.0.3",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.3",
    "globals": "15.1.0",
    "husky": "8.0.3",
    "inquirer": "13.2.2",
    "lint-staged": "13.2.3",
    "nodemon": "3.1.11",
    "prettier": "3.8.1",
    "release-it": "19.2.4"
  }
}
